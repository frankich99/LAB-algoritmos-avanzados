# ============================================================================
# .gitignore - UNSAAC Algoritmos Avanzados
# Excluir proyectos y archivos temporales para mantener solo laboratorios
# ============================================================================

# Excluir proyectos externos al repositorio de laboratorios
proyecto/
proyecto - copia/
scratch_cells.txt

# Python y compilados
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini
proyecto.rar
